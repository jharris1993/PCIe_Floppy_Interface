# Store and check out ordinary text files with LF endings.
* text=auto eol=lf

# Preserve conventional Windows endings where compatibility warrants it.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never perform line-ending conversion on binary artifacts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.7z binary
*.gz binary
*.docx binary
*.xlsx binary
*.pptx binary
*.img binary
*.ima binary
*.dsk binary

# Preserve externally sourced reference snapshots byte-for-byte.
Reference_Implementations/Greaseweazle/Snapshot/** -text
Reference_Implementations/Greaseweazle/Wiki_Snapshot/** -text
Reference_Implementations/Greaseweazle/Wiki_Artifacts/** -text
Reference_Implementations/USB_Floppy_Adapter/Snapshot/** -text
